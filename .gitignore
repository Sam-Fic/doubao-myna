# dpkg-buildpackage 在 debian/ 下留的中间产物
# (debian/icons/ 与 debian/doubao-input.triggers 是源文件,不能忽略)
debian/.debhelper/
debian/doubao-input/
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/*.debhelper

# Test/debug artifacts
/tmp/
/.cache/doubao-input_*.deb
*.changes
*.buildinfo

# IDE / agent working memory
.codebuddy/

# gettext 编译产物(.po 由 i18n 在运行时现编)
src/doubao_input/locale/*/LC_MESSAGES/*.mo

# vendored myna-hud:构建产物与运行时生成的版本号
# (.version 在打包时由 debian/rules 按 changelog 重新生成)
vendor/target/
vendor/.version
