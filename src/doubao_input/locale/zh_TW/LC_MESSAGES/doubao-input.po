msgstr "下一步"

msgid "None"
msgstr "無"

msgid "Not set"
msgstr "未設定"

msgid "Not signed in"
msgstr "未登入"

msgid "Not signed in to Doubao yet; holding Right Ctrl won't trigger recognition"
msgstr "尚未登入豆包,按住右 Ctrl 不會觸發辨識"

msgid "Not signed in · click “Sign in to Doubao” to log in once"
msgstr "未登入 · 點擊「登入豆包」完成一次登入"

msgid "Not signed in · please sign in once first"
msgstr "未登入 · 請先完成一次登入"

