msgid "\nRecognition is done by Doubao's web service; login credentials are stored only on this machine and never sent to third parties."
msgstr "\n辨識由豆包的網頁服務完成;登入憑證只保存在本機,不會傳給第三方。"

msgid "%s is already taken by “%s”"
msgstr "%s 已被「%s」佔用"

msgid "%s is already used by “%s”. Replacing removes it from there."
msgstr "%s 已被「%s」使用。替換會把它從那裡移除。"

msgid "%s is reserved by the desktop (%s); pick another"
msgstr "%s 被桌面保留(%s),換一個吧"

msgid "0 = never auto-stop (matches Myna's silence-timeout)"
msgstr "0 = 不自動結束(對齊 Myna 的 silence-timeout)"

msgid "<b>Note</b>\n• In terminal, manually use Ctrl+Shift+V\n• Credentials stored at %s\n"
msgstr "<b>注意</b>\n• 終端機裡需手動 Ctrl+Shift+V\n• 憑證保存在 %s\n"

