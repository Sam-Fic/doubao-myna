msgstr "狀態:<b>已登入</b>  ✅"

msgid "Stop listening and quit completely; closing the window only hides it to the tray"
msgstr "停止監聽並徹底結束;關閉視窗只會隱藏到系統匣"

msgid "Stop on focus loss"
msgstr "焦點離開時結束"

msgid "Tap to start / tap to stop"
msgstr "按一下開始 / 再按一下結束"

msgid "Test"
msgstr "測試"

msgid "Test complete  peak=%0.2f  avg=%0.3f"
msgstr "測試完成  peak=%0.2f  avg=%0.3f"

msgid "Test complete (no data)"
msgstr "測試完成(無資料)"

msgid "Test paste (inject 'hello 测试 123')"
msgstr "測試貼上 (注入 'hello 測試 123')"

msgid "Testing the microphone…"
msgstr "麥克風測試中…"

msgid "The report contains no audio, transcribed text, or any file paths (paths are replaced with [redacted])."
msgstr "報告不含音訊、辨識文字或任何檔案路徑(路徑一律替換為 [redacted])。"

msgid "Transcribing…"
msgstr "辨識中…"

msgid "Trigger"
msgstr "觸發"

msgid "Trigger mode"
msgstr "觸發方式"

msgid "Trigger mode: %s"
msgstr "觸發方式: %s"

msgid "Unknown (%s)"
msgstr "未知 (%s)"

msgid "Use Ctrl / Alt / Super plus another key, or a function key on its own. Esc cancels."
msgstr "用 Ctrl / Alt / Super 加上另一個鍵,或單獨的功能鍵。Esc 取消。"

msgid "Use Ctrl+Shift+V"
msgstr "使用 Ctrl+Shift+V"

msgid "Use Myna floating capsule"
msgstr "使用 Myna 懸浮膠囊"

msgid "Waveform style"
msgstr "波形樣式"

msgid "Welcome to Doubao Voice Input"
msgstr "歡迎使用豆包語音輸入法"

msgid "Works without it"
msgstr "不裝也能用"

msgid "Writes a custom desktop shortcut whose command is D-Bus Toggle"
msgstr "寫進桌面的自訂快速鍵,指令是 D-Bus Toggle"

msgid "You need to sign in once the first time; credentials are reused afterwards. Clicking “Sign in to Doubao” opens a web window where you just log in normally."
msgstr "第一次使用需要登入一次,之後憑證會重複使用。點「登入豆包」會開啟一個網頁視窗,在裡面正常登入即可。"

msgid "autostart state did not change"
msgstr "開機自啟狀態沒有變化"

msgid "no systemd user service, and ~/.config/autostart is not writable"
msgstr "沒有 systemd 使用者服務,且 ~/.config/autostart 不可寫"

msgid "systemctl is not available"
msgstr "未找到 systemctl"

msgid "（no usable player found; silent）"
msgstr "(找不到可用的播放工具,不會響)"
