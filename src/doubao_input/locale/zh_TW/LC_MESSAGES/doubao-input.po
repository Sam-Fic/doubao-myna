msgstr "關於%s"

msgid "Account"
msgstr "帳號"

msgid "Actions"
msgstr "操作"

msgid "Application"
msgstr "應用程式"

msgid "Auto-stop on silence (seconds)"
msgstr "靜音自動結束(秒)"

msgid "Back"
msgstr "上一步"

msgid "Cancel"
msgstr "取消"

msgid "Capture 3 seconds and print the RMS peak"
msgstr "擷取 3 秒並輸出 RMS 峰值"

