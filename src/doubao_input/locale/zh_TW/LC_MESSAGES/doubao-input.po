msgstr "懸浮膠囊"

msgid "Floating window"
msgstr "懸浮視窗"

msgid "Floating window status unknown (%s)"
msgstr "懸浮視窗狀態未知 (%s)"

msgid "Focus left the window; nothing was typed"
msgstr "焦點已離開,本次未輸入"

msgid "Hold to talk (release to stop)"
msgstr "按住說話(放開即結束)"

msgid "Injecting the test string now…"
msgstr "正在注入 'hello 測試 123'…"

msgid "Injects a fixed text to verify wl-copy + uinput"
msgstr "注入一段固定文字,驗證 wl-copy + uinput"

