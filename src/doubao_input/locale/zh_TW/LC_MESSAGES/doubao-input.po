msgstr "Wayland 下第三方行程讀不到其它視窗的焦點(需 X11 工作階段或 GNOME Shell 擴充功能)"

msgid "On: pasting also works in terminals; Off: only Ctrl+V in GUI apps"
msgstr "開啟:終端機也能貼上;關閉:僅 GUI 應用程式可用的 Ctrl+V"

msgid "Optional: Myna's myna-hud draws the recording indicator."
msgstr "可選項:用 Myna 的 myna-hud 繪製錄音指示器。"

msgid "Paste failed; the text is still on the clipboard"
msgstr "貼上失敗,文字仍在剪貼簿"

msgid "Paste failed; the text is still on the clipboard — press Ctrl+Shift+V"
msgstr "貼上失敗,文字仍在剪貼簿,可手動 Ctrl+Shift+V"

msgid "Paste method"
msgstr "貼上方式"

msgid "Paste pipeline"
msgstr "貼上鏈路"

msgid "Physical key"
msgstr "實體鍵"

msgid "Physical key set to %s"
msgstr "實體鍵已設為 %s"

msgid "Played on start / stop / error"
msgstr "開始 / 結束 / 錯誤時播放"

msgid "Please speak into the microphone"
msgstr "請對麥克風說話"

msgid "Press a new shortcut…"
msgstr "按下新的快速鍵…"

msgid "Quit"
msgstr "退出"

msgid "Re-check local machine and component status"
msgstr "重新檢查本機與各元件狀態"

