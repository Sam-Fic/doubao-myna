msgstr "狀態"

msgid "Status: <b>Detecting…</b>"
msgstr "狀態:<b>偵測中…</b>"

msgid "Status: <b>Not signed in</b>  ❌\nClick “Sign in to Doubao” to log in once."
msgstr "狀態:<b>未登入</b>  ❌\n請點擊「登入豆包」完成一次登入。"

